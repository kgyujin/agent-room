{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Room",
  "version": "0.1.0",
  "identifier": "dev.agentroom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Room",
        "width": 980,
        "height": 700,
        "minWidth": 300,
        "minHeight": 260,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Watch your AI coding agents live in a tiny cozy room",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/agent-room-hook"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
