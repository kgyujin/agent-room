{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Room",
  "version": "0.3.0",
  "identifier": "dev.agentroom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Room",
        "width": 1100,
        "height": 800,
        "minWidth": 300,
        "minHeight": 260,
        "resizable": true,
        "transparent": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Watch your AI coding agents live in a tiny cozy room",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/agent-room-hook"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-", "entitlements": "Entitlements.plist" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMTM4QzgwREU1MDhFN0MKUldSOGpsRGVnSXdUblhKWDJSY0RmN0Jjck40NGZWNmF4ZkQyZmFUaDQrVU54TG0zMEtRdWY1SngK",
      "endpoints": ["https://github.com/kgyujin/agent-room/releases/latest/download/latest.json"]
    }
  }
}
